stdin=serial
stdout=serial,vidconsole
stderr=serial,vidconsole

kernel_addr_r=0x80008000
ramdisk_addr_r=0x84000000
fdt_addr_r=0x80000000

do_fastboot=echo "SLOWBOOT MODE =>"; \
	fastboot usb 0

do_usbacm=setenv stdin serial,usbacm; \
	setenv stdout serial,vidconsole,usbacm; \
	setenv stderr serial,vidconsole,usbacm;

bootmenu_0=Enable fastboot mode=run do_fastboot
bootmenu_1=Enable USB serial=run do_usbacm
bootmenu_2=Reboot=reset
bootmenu_3=Poweroff=poweroff

boot_android=echo "Loading Android boot image from eMMC..."; \
	mmc dev 0; \
	mmc read ${kernel_addr_r} 0xec00 0x3000; \
	bootm ${kernel_addr_r}

boot_recovery=echo "Loading recovery image from eMMC..."; \
	mmc dev 0; \
	mmc read ${kernel_addr_r} 0x11c00 0x3000; \
	bootm ${kernel_addr_r}

bootcmd=echo "Lenovo A319 U-Boot ready"
bootdelay=1

fastboot.platform=mt6572
platform=mt6572

# MTK partition map for fastboot.
# Offsets are the scatter "linear_start_addr" minus 0xC00000: the scatter
# counts the preloader region, which lives in the eMMC boot0 area, as part
# of the user area. Verified against a full eMMC dump.
# Format: <lba_start> <lba_size> [mmcpart <num>]
fastboot_raw_partition_preloader=0x0 0x6000 mmcpart 1
fastboot_raw_partition_mbr=0x0 0x400
fastboot_raw_partition_ebr1=0x400 0x400
fastboot_raw_partition_pro_info=0x800 0x1800
fastboot_raw_partition_nvram=0x2000 0x2800
fastboot_raw_partition_protect_f=0x4800 0x5000
fastboot_raw_partition_protect_s=0x9800 0x5000
fastboot_raw_partition_seccfg=0xe800 0x100
fastboot_raw_partition_uboot=0xe900 0x300
fastboot_raw_partition_bootimg=0xec00 0x3000
fastboot_raw_partition_recovery=0x11c00 0x3000
fastboot_raw_partition_sec_ro=0x14c00 0x200
fastboot_raw_partition_misc=0x14e00 0x400
fastboot_raw_partition_logo=0x15200 0x1800
fastboot_raw_partition_expdb=0x16a00 0x5000
fastboot_raw_partition_android=0x1ba00 0x2ee000
fastboot_raw_partition_cache=0x309a00 0x71000
fastboot_raw_partition_usrdata=0x37aa00 0x3c2e00
fastboot_raw_partition_bmtpool=0x7f9f80 0xa800
